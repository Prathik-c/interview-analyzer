# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Groq Models
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Database Configuration (PostgreSQL with SQLite local dev fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_db

# Storage Paths
DATA_DIR=data/sessions
UPLOAD_DIR=uploads

# Multimodal Evaluation Weights (Sum must equal 1.0)
WEIGHT_NLP=0.50
WEIGHT_SPEECH=0.25
WEIGHT_VIDEO=0.25

# Application Settings
APP_TITLE=AI-Powered Multimodal Interview Performance Analyser
APP_ENV=development
DEBUG=true

# Local Structured Evaluation Settings (Zero-Cost Local Layer)
STRUCTURED_EVALUATION_ENABLED=true
STRUCTURED_EVALUATION_WEIGHT=0.25
